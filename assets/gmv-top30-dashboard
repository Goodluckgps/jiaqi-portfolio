<div class="hint" style="margin-top:10px">💡 直接上传「【Y26】直播间宝贝排行」整份 xlsx 即可——会自动找到该 sheet、识别6个品类分块、把月份下填到每个产品行并跳过合计行。也兼容普通扁平表（含 品类/产品/店铺/GMV/销量/月份 列）。品类板块可横向滚动；可拖拽文件到页面上传。</div>

<div class="modal-mask" id="mapModal" style="top: 48px;">
  <div class="modal">
    <h3>字段映射</h3>
    <div class="desc">未能完全自动识别列名，请确认下面各字段对应底表的哪一列：</div>
    <div id="mapRows"></div>
    <div class="foot">
      <button class="btn" onclick="closeModal()">取消</button>
      <button class="btn primary" onclick="applyMapping()">确认</button>
    </div>
  </div>
</div>

<script>
/* ================= 全局状态 ================= */
let rawRows = [];            // {cat, name, shop, gmv, qty, ym}
let months = [];             // 排序后的 yyyy-mm 列表
let granularity = 'month';
let pendingHeaders = null, pendingData = null;

const CAT_COLORS = ['#2f5fd0','#5aa14a','#e8842c','#d9a916','#7b52ab','#c2504f','#2f9e8f','#8a6d3b'];

/* ================= 列名自动识别 ================= */
const FIELD_DEFS = [
  {key:'cat',  label:'品类',   pats:[/品类/,/类目/,/category/i]},
  {key:'name', label:'产品名称', pats:[/产品/,/商品/,/宝贝/,/名称/,/product/i,/title/i]},
  {key:'shop', label:'店铺',   pats:[/店铺/,/店名/,/shop/i,/store/i]},
  {key:'gmv',  label:'GMV',   pats:[/gmv/i,/销售额/,/成交额/,/金额/]},
  {key:'qty',  label:'销量',   pats:[/销量/,/件数/,/数量/,/qty/i,/sales?_?(count|num)/i]},
  {key:'ym',   label:'月份',   pats:[/月份/,/月度/,/^月$/,/时间/,/日期/,/month/i,/date/i]},
];

function autoMap(headers){
  const map = {};
  for(const f of FIELD_DEFS){
    const hit = headers.find(h => f.pats.some(p => p.test(String(h).trim())));
    if(hit) map[f.key] = hit;
  }
  return map;
}

/* ================= 文件解析 ================= */
/* ================= 多分块「宝贝排行」表结构识别与扁平化 ================= */
function findRankSheet(wb){
  // 优先按名称
  const byName = wb.SheetNames.find(n => /宝贝排行|直播间/.test(n));
  if(byName) return {name:byName, sheet:wb.Sheets[byName]};
  // 否则按表头特征打分
  let best=null, bestScore=-1;
  for(const n of wb.SheetNames){
    const aoa = XLSX.utils.sheet_to_json(wb.Sheets[n], {header:1, defval:''});
    let score=0;
    for(let r=0;r<Math.min(5,aoa.length);r++){
      const row=aoa[r]||[];
      if(row.some(c=>/月份/.test(String(c)))) score++;
      if(row.some(c=>/产品|商品|宝贝/.test(String(c)))) score++;
      if(row.some(c=>/GMV|销售额|成交额/i.test(String(c)))) score++;
    }
    if(score>bestScore){ bestScore=score; best={name:n, sheet:wb.Sheets[n]}; }
  }
  return best;
}

function flattenRankSheet(sheet){
  const aoa = XLSX.utils.sheet_to_json(sheet, {header:1, defval:'', cellDates:true});
  if(!aoa.length) return null;
  // 定位表头行（同时含 月份/产品/GMV）
  let hrow=-1;
  for(let r=0;r<Math.min(8,aoa.length);r++){
    const row=aoa[r]||[];
    if(row.some(c=>/月份/.test(String(c)))
       && row.some(c=>/产品|商品|宝贝/.test(String(c)))
       && row.some(c=>/GMV|销售额|成交额|金额/i.test(String(c)))){
      hrow=r; break;
    }
  }
  if(hrow<0) return null;
  const header = aoa[hrow];
  // 分块起始列 = 表头为「月份」的位置
  const starts=[];
  header.forEach((c,i)=>{ if(/月份/.test(String(c).trim())) starts.push(i); });
  if(!starts.length) return null;
  // 用首个分块确定各字段相对偏移
  const firstEnd = starts[1] || header.length;
  const off={};
  for(let i=starts[0]; i<firstEnd; i++){
    const h=String(header[i]).trim();
    if(/月份/.test(h)) off.ym=i;
    else if(/店铺|店名/.test(h)) off.shop=i;
    else if(/分类|类目/.test(h)) off.cat=i;
    else if((/产品|商品|名称/.test(h)) || (/宝贝/.test(h) && !/图片/.test(h))) off.name=i;
    else if(/GMV|销售额|成交额|金额/i.test(h)) off.gmv=i;
    else if(/销量|件数|数量/.test(h)) off.qty=i;
  }
  if(off.ym==null || off.name==null || off.gmv==null) return null;
  const rel = {ym:off.ym-starts[0], shop:off.shop!=null?off.shop-starts[0]:null, cat:off.cat!=null?off.cat-starts[0]:null, name:off.name-starts[0], gmv:off.gmv-starts[0], qty:off.qty!=null?off.qty-starts[0]:null};
  const catRow = aoa[hrow-1] || [];
  const rows=[];
  for(const s of starts){
    let curMonth=null;
    let catLabel = catRow[s] ? String(catRow[s]).trim() : '';
    for(let r=hrow+1; r<aoa.length; r++){
      const row=aoa[r]||[];
      const ymVal = row[s+rel.ym];
      const ym = normYM(ymVal);
      if(ym) curMonth=ym;                       // 合计行带月份 → 记录当前月
      const nameVal = row[s+rel.name];
      if(nameVal==null || String(nameVal).trim()==='') continue;
      if(/合计/.test(String(nameVal))) continue; // 跳过合计行
      if(!curMonth) continue;
      let cat = catLabel;
      if(!cat && rel.cat!=null){
        const cf=row[s+rel.cat];
        cat = cf ? String(cf).split('>>')[0].trim() : ('品类'+s);
      }
      rows.push({
        cat: cat || ('品类'+s),
        name: String(nameVal).trim(),
        ym: curMonth,
        shop: rel.shop!=null ? String(row[s+rel.shop] ?? '').trim() : '',
        gmv: normNum(row[s+rel.gmv]),
        qty: rel.qty!=null ? normNum(row[s+rel.qty]) : 0,
      });
    }
  }
  return rows;
}

function handleFile(file){
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try{
      const wb = XLSX.read(e.target.result, {type:'array', cellDates:true});
      // 1) 先尝试「宝贝排行」多分块结构
      const rs = findRankSheet(wb);
      if(rs){
        const flat = flattenRankSheet(rs.sheet);
        if(flat && flat.length){
          rawRows = flat;
          document.getElementById('dataTag').textContent = file.name + ' · ' + flat.length + ' 行（已自动扁平化）';
          rebuildFilters(); render();
          return;
        }
      }
      // 2) 回退：按通用扁平表解析（选行数最多的 sheet）
      let best = null, bestLen = 0;
      wb.SheetNames.forEach(n=>{
        const js = XLSX.utils.sheet_to_json(wb.Sheets[n], {defval:''});
        if(js.length > bestLen){ bestLen = js.length; best = js; }
      });
      if(!best || !best.length){ alert('没有解析到数据，请检查文件内容'); return; }
      const headers = Object.keys(best[0]);
      const map = autoMap(headers);
      const required = ['cat','name','gmv','ym'];
      if(required.every(k=>map[k])){
        ingest(best, map, file.name);
      }else{
        pendingHeaders = headers; pendingData = best;
        openModal(headers, map);
      }
    }catch(err){ alert('解析失败：' + err.message); }
  };
  reader.readAsArrayBuffer(file);
  document.getElementById('fileInput').value = '';
}

function openModal(headers, map){
  const box = document.getElementById('mapRows');
  box.innerHTML = FIELD_DEFS.map(f=>{
    const opts = ['<option value="">（无此列）</option>'].concat(
      headers.map(h=>`<option value="${escAttr(h)}" ${map[f.key]===h?'selected':''}>${esc(h)}</option>`)
    ).join('');
    const req = ['cat','name','gmv','ym'].includes(f.key) ? ' *' : '';
    return `<div class="map-row"><label>${f.label}${req}</label><select data-key="${f.key}">${opts}</select></div>`;
  }).join('');
  document.getElementById('mapModal').style.display = 'flex';
}
function closeModal(){ document.getElementById('mapModal').style.display = 'none'; }
function applyMapping(){
  const map = {};
  document.querySelectorAll('#mapRows select').forEach(s=>{ if(s.value) map[s.dataset.key] = s.value; });
  for(const k of ['cat','name','gmv','ym']){
    if(!map[k]){ alert('「' + FIELD_DEFS.find(f=>f.key===k).label + '」为必选字段'); return; }
  }
  closeModal();
  ingest(pendingData, map, '已上传文件');
}

function normYM(v){
  if(v == null || v === '') return null;
  if(v instanceof Date) return v.getUTCFullYear() + '-' + String(v.getUTCMonth()+1).padStart(2,'0');
  const s = String(v).trim();
  // Excel 序列号日期（先判断，避免被下面的正则误匹配成"4602-03"）；用 UTC 避免时区错位
  const n = Number(s);
  if(!isNaN(n) && n > 20000 && n < 60000){
    const d = new Date(Math.round((n - 25569) * 86400 * 1000));
    return d.getUTCFullYear() + '-' + String(d.getUTCMonth()+1).padStart(2,'0');
  }
  let m = s.match(/(\d{4})[-/年.]?\s*(\d{1,2})/);
  if(m){ const mo = +m[2]; if(mo>=1 && mo<=12) return m[1] + '-' + String(mo).padStart(2,'0'); }
  return null;
}
function normNum(v){
  if(typeof v === 'number') return v;
  const n = parseFloat(String(v).replace(/[,¥￥\s]/g,''));
  return isNaN(n) ? 0 : n;
}

function ingest(data, map, sourceName){
  const rows = [];
  for(const r of data){
    const ym = normYM(r[map.ym]);
    if(!ym) continue;
    const cat = String(r[map.cat] ?? '').trim();
    const name = String(r[map.name] ?? '').trim();
    if(!cat || !name) continue;
    rows.push({
      cat, name, ym,
      shop: map.shop ? String(r[map.shop] ?? '').trim() : '',
      gmv: normNum(r[map.gmv]),
      qty: map.qty ? normNum(r[map.qty]) : 0,
    });
  }
  if(!rows.length){ alert('没有解析到有效数据行（请检查月份列格式，如 2026-01）'); return; }
  rawRows = rows;
  document.getElementById('dataTag').textContent = sourceName + ' · ' + rows.length + ' 行';
  rebuildFilters();
  render();
}

/* ================= 时间段 ================= */
function rebuildFilters(){
  months = [...new Set(rawRows.map(r=>r.ym))].sort();
  const cats = [...new Set(rawRows.map(r=>r.cat))];
  const catSel = document.getElementById('catSel');
  catSel.innerHTML = '<option value="__all__">全部品类</option>' + cats.map(c=>`<option value="${escAttr(c)}">${esc(c)}</option>`).join('');
  buildPeriodOptions();
}

function periodsFor(g){
  const set = new Map(); // key -> {label, months:[]}
  for(const ym of months){
    const [y, m] = ym.split('-').map(Number);
    let key, label;
    if(g === 'month'){ key = ym; label = ym; }
    else if(g === 'quarter'){ const q = Math.ceil(m/3); key = y + '-Q' + q; label = y + ' 年 Q' + q; }
    else if(g === 'half'){ const h = m <= 6 ? 'H1' : 'H2'; key = y + '-' + h; label = y + ' 年' + (h==='H1'?'上半年':'下半年'); }
    else { key = String(y); label = y + ' 全年'; }
    if(!set.has(key)) set.set(key, {label, months:[]});
    set.get(key).months.push(ym);
  }
  return [...set.entries()].sort((a,b)=>a[0]<b[0]?-1:1).map(([key,v])=>({key, ...v}));
}

function buildPeriodOptions(){
  const g = granularity;
  document.getElementById('periodBox').style.display = g === 'range' ? 'none' : 'flex';
  document.getElementById('rangeBox').style.display = g === 'range' ? 'flex' : 'none';
  if(g === 'range'){
    const opts = months.map(m=>`<option value="${m}">${m}</option>`).join('');
    const f = document.getElementById('rangeFrom'), t = document.getElementById('rangeTo');
    f.innerHTML = opts; t.innerHTML = opts;
    if(months.length){ f.value = months[0]; t.value = months[months.length-1]; }
  }else{
    const ps = periodsFor(g);
    const sel = document.getElementById('periodSel');
    sel.innerHTML = ps.map(p=>`<option value="${p.key}">${p.label}</option>`).join('');
    if(ps.length) sel.value = ps[ps.length-1].key; // 默认最新
  }
}

function selectedMonths(){
  if(granularity === 'range'){
    let f = document.getElementById('rangeFrom').value, t = document.getElementById('rangeTo').value;
    if(f > t) [f, t] = [t, f];
    return months.filter(m => m >= f && m <= t);
  }
  const ps = periodsFor(granularity);
  const cur = ps.find(p => p.key === document.getElementById('periodSel').value);
  return cur ? cur.months : [];
}

/* ================= 渲染 ================= */
function fmt(n){
  if(n >= 1e8) return (n/1e8).toFixed(2) + ' 亿';
  if(n >= 1e4) return (n/1e4).toFixed(1) + ' 万';
  return Math.round(n).toLocaleString();
}
function fmtInt(n){ return Math.round(n).toLocaleString(); }
function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function escAttr(s){ return esc(s).replace(/"/g,'&quot;'); }

function render(){
  const ms = selectedMonths();
  const msSet = new Set(ms);
  const catFilter = document.getElementById('catSel').value;
  const topn = +document.getElementById('topnSel').value;
  const kw = document.getElementById('searchInput').value.trim().toLowerCase();

  let rows = rawRows.filter(r => msSet.has(r.ym));
  if(catFilter !== '__all__') rows = rows.filter(r => r.cat === catFilter);
  if(kw) rows = rows.filter(r => r.name.toLowerCase().includes(kw) || r.shop.toLowerCase().includes(kw));

  // 跨月按 产品+店铺 聚合
  const catMap = new Map();
  for(const r of rows){
    if(!catMap.has(r.cat)) catMap.set(r.cat, new Map());
    const pm = catMap.get(r.cat);
    const pk = r.name + '|' + r.shop;
    if(!pm.has(pk)) pm.set(pk, {name:r.name, shop:r.shop, gmv:0, qty:0});
    const p = pm.get(pk);
    p.gmv += r.gmv; p.qty += r.qty;
  }

  // KPI
  const totalGmv = rows.reduce((s,r)=>s+r.gmv,0);
  const totalQty = rows.reduce((s,r)=>s+r.qty,0);
  const nProducts = [...catMap.values()].reduce((s,pm)=>s+pm.size,0);
  const label = ms.length ? (ms.length === 1 ? ms[0] : ms[0] + ' ~ ' + ms[ms.length-1]) : '—';
  document.getElementById('kpiRow').innerHTML = [
    ['当前时间段', label, ms.length + ' 个月'],
    ['总 GMV', '¥' + fmt(totalGmv), ''],
    ['总销量', fmt(totalQty), ''],
    ['品类数', catMap.size, ''],
    ['商品数（去重）', fmtInt(nProducts), ''],
  ].map(([l,v,s])=>`<div class="kpi"><div class="l">${l}</div><div class="v">${v}</div><div class="l">${s}</div></div>`).join('');

  // 品类板块（按品类总GMV降序）
  const boards = document.getElementById('boards');
  if(!catMap.size){
    boards.innerHTML = '<div class="panel empty" style="flex:1"><div class="big">📂</div>暂无数据 — 请上传底表，或点击「演示数据」预览效果</div>';
    return;
  }
  const catArr = [...catMap.entries()].map(([cat,pm])=>{
    const items = [...pm.values()].sort((a,b)=>b.gmv-a.gmv);
    return {cat, items, total: items.reduce((s,p)=>s+p.gmv,0)};
  }).sort((a,b)=>b.total-a.total);

  boards.innerHTML = catArr.map((c,ci)=>{
    const color = CAT_COLORS[ci % CAT_COLORS.length];
    const list = topn > 0 ? c.items.slice(0, topn) : c.items;
    const maxGmv = list.length ? list[0].gmv : 1;
    const trs = list.map((p,i)=>{
      const rk = i+1;
      const rcls = rk<=3 ? ' r'+rk : '';
      const w = maxGmv ? Math.max(2, p.gmv/maxGmv*100) : 0;
      return `<tr>
        <td><span class="rank${rcls}">${rk}</span></td>
        <td><div class="pname" title="${escAttr(p.name)}">${esc(p.name)}</div><div class="shop">${esc(p.shop)}</div></td>
        <td class="num gmv bar-cell"><div class="bar-bg" style="width:${w}%"></div><span>${fmtInt(p.gmv)}</span></td>
        <td class="num">${p.qty ? fmtInt(p.qty) : '-'}</td>
      </tr>`;
    }).join('');
    return `<div class="board">
      <div class="board-head" style="background:${color}">
        <span>${esc(c.cat)}</span>
        <span class="total">GMV ¥${fmt(c.total)} · ${c.items.length} 个商品</span>
      </div>
      <div class="tbl-wrap"><table>
        <thead><tr><th style="width:36px">#</th><th>产品 / 店铺</th><th class="num">GMV</th><th class="num">销量</th></tr></thead>
        <tbody>${trs || '<tr><td colspan="4" style="text-align:center;color:var(--sub);padding:20px">无匹配数据</td></tr>'}</tbody>
      </table></div>
    </div>`;
  }).join('');
}

/* ================= 导出 ================= */
function exportCSV(){
  if(!rawRows.length){ alert('暂无数据'); return; }
  const ms = new Set(selectedMonths());
  const catFilter = document.getElementById('catSel').value;
  const topn = +document.getElementById('topnSel').value;
  let rows = rawRows.filter(r => ms.has(r.ym));
  if(catFilter !== '__all__') rows = rows.filter(r=>r.cat===catFilter);
  const catMap = new Map();
  for(const r of rows){
    if(!catMap.has(r.cat)) catMap.set(r.cat, new Map());
    const pm = catMap.get(r.cat), pk = r.name+'|'+r.shop;
    if(!pm.has(pk)) pm.set(pk,{name:r.name,shop:r.shop,gmv:0,qty:0});
    const p = pm.get(pk); p.gmv+=r.gmv; p.qty+=r.qty;
  }
  let csv = '\ufeff品类,排名,产品名称,店铺,GMV,销量\n';
  for(const [cat,pm] of catMap){
    let items = [...pm.values()].sort((a,b)=>b.gmv-a.gmv);
    if(topn>0) items = items.slice(0,topn);
    items.forEach((p,i)=>{
      csv += [cat, i+1, '"'+p.name.replace(/"/g,'""')+'"', '"'+p.shop.replace(/"/g,'""')+'"', Math.round(p.gmv), Math.round(p.qty)].join(',') + '\n';
    });
  }
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], {type:'text/csv'}));
  a.download = 'GMV_Top榜单.csv';
  a.click();
}

